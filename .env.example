# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/history_hub?schema=public"
# Public base URL (used for QR codes / join links / password reset links)
APP_URL="http://localhost:3000"

# File storage: "local" or "s3" (S3-compatible: AWS S3, Cloudflare R2, Supabase Storage S3 API, MinIO)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Folder with original teaching materials (PPTX/PDF/DOCX) for `npm run import:materials`
MATERIALS_DIR=".."

# Dev-only seed passwords (seed refuses to run in production without explicit values)
SEED_ADMIN_PASSWORD=""
SEED_MODERATOR_PASSWORD=""
SEED_TEACHER_PASSWORD=""
